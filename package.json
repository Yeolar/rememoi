{
  "name": "rememoi",
  "version": "0.1.0",
  "private": true,
  "description": "Rememoi — a personal blog built with Next.js, inspired by the Astro Theme Pure design.",
  "scripts": {
    "dev": "pnpm db:setup && next dev",
    "build": "pnpm db:setup && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,mdx,json}\"",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/db-setup.ts --force"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@shikijs/transformers": "4.6.0",
    "@waline/client": "^3.16.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.1",
    "image-size": "^2.0.4",
    "katex": "^0.16.25",
    "mdast-util-to-string": "^4.0.0",
    "medium-zoom": "^1.1.2",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.7.0"
}
