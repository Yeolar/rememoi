# Canonical site URL used for metadata, RSS, sitemap and share links.
# Set this to your production URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database: local SQLite file, or a remote libSQL/Turso database.
DATABASE_URL=file:./data/rememoi.db
# DATABASE_AUTH_TOKEN=only-needed-for-remote-libsql

# Auth.js
# Required in production. Generate with: openssl rand -base64 32
# Empty is okay in development (a local fallback secret is used).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma separated GitHub usernames allowed into /admin
ADMIN_GITHUB_LOGINS=Yeolar

# Local development login (enabled automatically in development)
ADMIN_DEV_PASSWORD=rememoi

# Bearer token for write API / agent access (create, update, upload).
# Generate a long random value, keep it server-side and send:
#   Authorization: Bearer <REMEMOI_API_TOKEN>
REMEMOI_API_TOKEN=
# ENABLE_DEV_LOGIN=true

# Image storage: "db" (default, SQLite/Turso BLOB) or "cos" (Tencent COS + CDN)
MEDIA_DRIVER=db
# Required when MEDIA_DRIVER=cos. Keep these server-side.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# Public CDN/base URL for uploaded objects, e.g. https://cdn.example.com
# Falls back to https://<bucket>.cos.<region>.myqcloud.com when empty.
COS_PUBLIC_BASE_URL=
# Optional object key prefix (default rememoi/media)
COS_KEY_PREFIX=rememoi/media

# Optional Waline comment server (comments stay hidden when empty)
NEXT_PUBLIC_WALINE_SERVER=
